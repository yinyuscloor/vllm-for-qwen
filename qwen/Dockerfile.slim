# syntax=docker/dockerfile:1
# 精简验证镜像：官方 vLLM 运行环境 + 本仓库精简后的 vllm/ 代码。
# 不重新编译源码，只替换 Python 代码，构建是秒级的。
# 构建上下文必须是仓库根目录：
#   docker build -f qwen/Dockerfile.slim -t vllm-slim:rN .

# 基础镜像：官方 vLLM 镜像，已装好 torch、CUDA 依赖和编译好的 vLLM
# （含 _C.abi3.so 等 C++/CUDA 扩展，这些 .so 在仓库源码树里是没有的）
FROM vllm/vllm-openai:latest

# 容器内工作目录
WORKDIR /workspace

# 定位镜像里已安装的 vllm 包目录（通常是 /usr/local/lib/python3.12/dist-packages/vllm），
# 并整体备份到 /opt/vllm_orig —— 备份是为了后面能还原编译产物（*.so）。
# 包路径写入文件接力，因为下一条 RUN 是新的 shell，变量传不过去。
RUN VLLM_DIR=$(python3 -c "import vllm, os; print(os.path.dirname(vllm.__file__))") && \
    cp -r "$VLLM_DIR" /opt/vllm_orig && \
    echo "$VLLM_DIR" > /opt/vllm_dir.txt

# 把仓库里精简后的 vllm/ 目录复制到镜像的临时位置
COPY vllm/ /opt/vllm_slim/

# 核心替换逻辑：
# 1) 先整个删掉原安装包，再拷入精简后的代码 —— 必须先删再拷，直接覆盖会留下
#    已被精简掉的旧 .py 文件，导致"删错引用"测不出来；
# 2) 从备份里找出所有 *.so 编译产物，按原目录结构拷回新包
#    （没有这步，import vllm 会因缺 _C 扩展而报错）；
# 3) 清理备份和临时目录，减小镜像体积；
# 4) 构建期冒烟检查：import vllm 一次，删错了引用在这里就失败，
#    不用等跑模型才发现。
RUN VLLM_DIR=$(cat /opt/vllm_dir.txt) && \
    rm -rf "$VLLM_DIR" && \
    cp -r /opt/vllm_slim "$VLLM_DIR" && \
    cd /opt/vllm_orig && \
    find . -name '*.so' -exec cp --parents {} "$VLLM_DIR" \; && \
    rm -rf /opt/vllm_orig /opt/vllm_slim && \
    python3 -c "import vllm; print('vllm import OK:', vllm.__file__)"

# 把验证脚本（slim_check.py）和文档拷进容器
COPY qwen/ /workspace/qwen/

# 容器启动即跑验证脚本；docker run 时追加的参数（如 --model xxx）会传给脚本
ENTRYPOINT ["python3", "/workspace/qwen/slim_check.py"]
